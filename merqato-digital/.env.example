# Neon Postgres
DATABASE_URL=

# Neon / S3-compatible object storage for the media library
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1

# Bucket names. MEDIA_BUCKET holds portfolio + section images and video.
# If only one bucket exists, point both at it — uploads fall back automatically.
MEDIA_BUCKET=site-images
LOGO_BUCKET=logos

# Bootstrap credential for the first admin sign-in at /admin
ADMIN_PASSKEY=

# Local preview only: serve the bundled starter portfolio when no database is reachable
# PORTFOLIO_DEMO=1
